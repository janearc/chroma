{
  "block_quote": {
    "color": "#99a9b1",
    "indent": 1,
    "indent_token": "│ "
  },
  "code": {
    "background_color": "#dee7df",
    "color": "#9e9d95",
    "prefix": " ",
    "suffix": " "
  },
  "code_block": {
    "chroma": {
      "background": {
        "background_color": "#dee7df"
      },
      "comment": {
        "color": "#c9bdbd",
        "italic": true
      },
      "comment_preproc": {
        "color": "#c9bdbd"
      },
      "error": {
        "color": "#94b7bd"
      },
      "generic_deleted": {
        "color": "#94b7bd"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#cabdca"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#989898"
      },
      "keyword": {
        "color": "#737c54"
      },
      "keyword_namespace": {
        "color": "#737c54"
      },
      "keyword_reserved": {
        "color": "#737c54"
      },
      "keyword_type": {
        "color": "#cabdca"
      },
      "literal": {
        "color": "#c5d4d1"
      },
      "literal_date": {
        "color": "#c5d4d1"
      },
      "literal_number": {
        "color": "#cfc1d7"
      },
      "literal_string": {
        "color": "#c5d4d1"
      },
      "literal_string_escape": {
        "color": "#737c54"
      },
      "name": {
        "color": "#9cb288"
      },
      "name_attribute": {
        "color": "#b8b09e"
      },
      "name_builtin": {
        "color": "#cabdca"
      },
      "name_class": {
        "bold": true,
        "color": "#b8b09e"
      },
      "name_constant": {
        "color": "#cfc1d7"
      },
      "name_decorator": {
        "color": "#c5d4d1"
      },
      "name_exception": {
        "color": "#737c54"
      },
      "name_function": {
        "color": "#b8b09e"
      },
      "name_other": {
        "color": "#9cb288"
      },
      "name_tag": {
        "color": "#737c54"
      },
      "operator": {
        "color": "#bbc8cc"
      },
      "punctuation": {
        "color": "#bbc8cc"
      },
      "text": {
        "color": "#b7c0c6"
      }
    },
    "color": "#b7c0c6",
    "margin": 2
  },
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "definition_list": {},
  "definition_term": {},
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#98a5a7",
    "margin": 2
  },
  "emph": {
    "color": "#bac6cb",
    "italic": true
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#acc5c7"
  },
  "h1": {
    "prefix": "# "
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "background_color": "#e1d0bd",
    "color": "#989898",
    "prefix": "### "
  },
  "h4": {
    "background_color": "#e1d0bd",
    "color": "#989898",
    "prefix": "#### "
  },
  "h5": {
    "background_color": "#e1d0bd",
    "color": "#989898",
    "prefix": "##### "
  },
  "h6": {
    "background_color": "#e1d0bd",
    "bold": false,
    "color": "#989898",
    "prefix": "###### "
  },
  "heading": {
    "background_color": "#e1d0bd",
    "block_suffix": "\n",
    "bold": true,
    "color": "#989898"
  },
  "hr": {
    "color": "#c7d4d6",
    "format": "\n────────\n"
  },
  "html_block": {},
  "html_span": {},
  "image": {
    "color": "#bac6cb",
    "underline": true
  },
  "image_text": {
    "color": "#c7d4d6",
    "format": "image: {{.text}} →"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#acc5c7"
  },
  "link": {
    "color": "#bac6cb",
    "underline": true
  },
  "link_text": {
    "bold": true,
    "color": "#bac6cb"
  },
  "list": {
    "level_indent": 2
  },
  "paragraph": {},
  "strikethrough": {
    "crossed_out": true
  },
  "strong": {
    "bold": true,
    "color": "#bac6cb"
  },
  "table": {},
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "text": {}
}
