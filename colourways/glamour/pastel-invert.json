{
  "block_quote": {
    "color": "#6a4600",
    "indent": 1,
    "indent_token": "│ "
  },
  "code": {
    "background_color": "#8ab873",
    "color": "#aa3cb3",
    "prefix": " ",
    "suffix": " "
  },
  "code_block": {
    "chroma": {
      "background": {
        "background_color": "#8ab873"
      },
      "comment": {
        "color": "#9f6900",
        "italic": true
      },
      "comment_preproc": {
        "color": "#9f6900"
      },
      "error": {
        "color": "#066c7c"
      },
      "generic_deleted": {
        "color": "#066c7c"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#3a2886"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#9d4d00"
      },
      "keyword": {
        "color": "#fb4e00"
      },
      "keyword_namespace": {
        "color": "#fb4e00"
      },
      "keyword_reserved": {
        "color": "#fb4e00"
      },
      "keyword_type": {
        "color": "#3a2886"
      },
      "literal": {
        "color": "#003fd6"
      },
      "literal_date": {
        "color": "#003fd6"
      },
      "literal_number": {
        "color": "#0000a0"
      },
      "literal_string": {
        "color": "#003fd6"
      },
      "literal_string_escape": {
        "color": "#fb4e00"
      },
      "name": {
        "color": "#644d8b"
      },
      "name_attribute": {
        "color": "#9d4d00"
      },
      "name_builtin": {
        "color": "#3a2886"
      },
      "name_class": {
        "bold": true,
        "color": "#9d4d00"
      },
      "name_constant": {
        "color": "#0000a0"
      },
      "name_decorator": {
        "color": "#003fd6"
      },
      "name_exception": {
        "color": "#fb4e00"
      },
      "name_function": {
        "color": "#9d4d00"
      },
      "name_other": {
        "color": "#644d8b"
      },
      "name_tag": {
        "color": "#fb4e00"
      },
      "operator": {
        "color": "#302da6"
      },
      "punctuation": {
        "color": "#302da6"
      },
      "text": {
        "color": "#aa3cb3"
      }
    },
    "color": "#aa3cb3",
    "margin": 2
  },
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "definition_list": {},
  "definition_term": {},
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#17517c",
    "margin": 2
  },
  "emph": {
    "color": "#17517c",
    "italic": true
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#17517c"
  },
  "h1": {
    "prefix": "# "
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "color": "#9d4d00",
    "prefix": "### "
  },
  "h4": {
    "color": "#9d4d00",
    "prefix": "#### "
  },
  "h5": {
    "color": "#9d4d00",
    "prefix": "##### "
  },
  "h6": {
    "bold": false,
    "color": "#9d4d00",
    "prefix": "###### "
  },
  "heading": {
    "background_color": "#88c077",
    "block_suffix": "\n",
    "bold": true,
    "color": "#b24942"
  },
  "hr": {
    "color": "#836409",
    "format": "\n────────\n"
  },
  "html_block": {},
  "html_span": {},
  "image": {
    "color": "#9d4d00",
    "underline": true
  },
  "image_text": {
    "color": "#836409",
    "format": "image: {{.text}} →"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#17517c"
  },
  "link": {
    "color": "#9d4d00",
    "underline": true
  },
  "link_text": {
    "bold": true,
    "color": "#9d4d00"
  },
  "list": {
    "level_indent": 2
  },
  "paragraph": {},
  "strikethrough": {
    "crossed_out": true
  },
  "strong": {
    "bold": true,
    "color": "#17517c"
  },
  "table": {},
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "text": {}
}
