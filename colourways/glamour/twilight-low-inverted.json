{
  "block_quote": {
    "color": "#2b5dc6",
    "indent": 1,
    "indent_token": "│ "
  },
  "code": {
    "background_color": "#002c4e",
    "color": "#804cc8",
    "prefix": " ",
    "suffix": " "
  },
  "code_block": {
    "chroma": {
      "background": {
        "background_color": "#002c4e"
      },
      "comment": {
        "color": "#2b5dc6",
        "italic": true
      },
      "comment_preproc": {
        "color": "#2b5dc6"
      },
      "error": {
        "color": "#00747a"
      },
      "generic_deleted": {
        "color": "#00747a"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#804cc8"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#835c00"
      },
      "keyword": {
        "color": "#00a22c"
      },
      "keyword_namespace": {
        "color": "#00a22c"
      },
      "keyword_reserved": {
        "color": "#00a22c"
      },
      "keyword_type": {
        "color": "#804cc8"
      },
      "literal": {
        "color": "#2551c4"
      },
      "literal_date": {
        "color": "#2551c4"
      },
      "literal_number": {
        "color": "#2551c4"
      },
      "literal_string": {
        "color": "#2551c4"
      },
      "literal_string_escape": {
        "color": "#00a22c"
      },
      "name": {
        "color": "#804cc8"
      },
      "name_attribute": {
        "color": "#835c00"
      },
      "name_builtin": {
        "color": "#804cc8"
      },
      "name_class": {
        "bold": true,
        "color": "#835c00"
      },
      "name_constant": {
        "color": "#2551c4"
      },
      "name_decorator": {
        "color": "#2551c4"
      },
      "name_exception": {
        "color": "#00a22c"
      },
      "name_function": {
        "color": "#835c00"
      },
      "name_other": {
        "color": "#804cc8"
      },
      "name_tag": {
        "color": "#00a22c"
      },
      "operator": {
        "color": "#392100"
      },
      "punctuation": {
        "color": "#392100"
      },
      "text": {
        "color": "#804cc8"
      }
    },
    "color": "#804cc8",
    "margin": 2
  },
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "definition_list": {},
  "definition_term": {},
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#392100",
    "margin": 2
  },
  "emph": {
    "color": "#392100",
    "italic": true
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#392100"
  },
  "h1": {
    "prefix": "# "
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "color": "#835c00",
    "prefix": "### "
  },
  "h4": {
    "color": "#835c00",
    "prefix": "#### "
  },
  "h5": {
    "color": "#835c00",
    "prefix": "##### "
  },
  "h6": {
    "bold": false,
    "color": "#835c00",
    "prefix": "###### "
  },
  "heading": {
    "block_suffix": "\n",
    "bold": true,
    "color": "#00a22c"
  },
  "hr": {
    "color": "#000000",
    "format": "\n────────\n"
  },
  "html_block": {},
  "html_span": {},
  "image": {
    "color": "#835c00",
    "underline": true
  },
  "image_text": {
    "color": "#2b5dc6",
    "format": "image: {{.text}} →"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#392100"
  },
  "link": {
    "color": "#835c00",
    "underline": true
  },
  "link_text": {
    "bold": true,
    "color": "#835c00"
  },
  "list": {
    "level_indent": 2
  },
  "paragraph": {},
  "strikethrough": {
    "crossed_out": true
  },
  "strong": {
    "bold": true,
    "color": "#392100"
  },
  "table": {},
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "text": {}
}
