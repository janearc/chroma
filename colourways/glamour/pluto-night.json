      },
      "name_builtin": {
        "color": "#738c70"
      },
      "name_class": {
        "bold": true,
        "color": "#3783ff"
      },
      "name_constant": {
        "color": "#6b8307"
      },
      "name_decorator": {
        "color": "#cd6950"
      },
      "name_exception": {
        "color": "#ce52ce"
      },
      "name_function": {
        "color": "#3783ff"
      },
      "name_other": {
        "color": "#ce52ce"
      },
      "name_tag": {
        "color": "#ce52ce"
      },
      "operator": {
        "color": "#9f7f6c"
      },
      "punctuation": {
        "color": "#9f7f6c"
      },
