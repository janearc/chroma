    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#d3c6c2",
    "margin": 2
  },
  "emph": {
    "color": "#958178",
    "italic": true
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#ff3030"
  },
  "h1": {
    "prefix": "# "
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "background_color": "#c942c9",
    "color": "#995555",
    "prefix": "### "
  },
  "h4": {
    "background_color": "#c942c9",
    "color": "#995555",
    "prefix": "#### "
  },
  "h5": {
    "background_color": "#c942c9",
    "color": "#995555",
    "prefix": "##### "
  },
  "h6": {
    "background_color": "#c942c9",
