      },
      "comment_preproc": {
        "color": "#967373"
      },
      "error": {
        "color": "#29f4f2"
      },
      "generic_deleted": {
        "color": "#29f4f2"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#8c738f"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#66aaaa"
      },
      "keyword": {
        "color": "#31ad31"
      },
      "keyword_namespace": {
        "color": "#31ad31"
      },
      "keyword_reserved": {
        "color": "#31ad31"
      },
      "keyword_type": {
        "color": "#8c738f"
      },
      "literal": {
        "color": "#3296af"
      },
      "literal_date": {
        "color": "#3296af"
      },
      "literal_number": {
        "color": "#947cf8"
      },
      "literal_string": {
        "color": "#3296af"
      },
      "literal_string_escape": {
        "color": "#31ad31"
      },
      "name": {
        "color": "#31ad31"
      },
      "name_attribute": {
        "color": "#c87c00"
      },
      "name_builtin": {
        "color": "#8c738f"
      },
      "name_class": {
        "bold": true,
        "color": "#c87c00"
      },
      "name_constant": {
        "color": "#947cf8"
      },
      "name_decorator": {
        "color": "#3296af"
      },
      "name_exception": {
        "color": "#31ad31"
      },
      "name_function": {
        "color": "#c87c00"
      },
      "name_other": {
        "color": "#31ad31"
      },
      "name_tag": {
        "color": "#31ad31"
      },
      "operator": {
        "color": "#608093"
      },
      "punctuation": {
        "color": "#608093"
      },
      "text": {
        "color": "#69737a"
      }
    },
    "color": "#69737a",
    "margin": 2
  },
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "definition_list": {},
  "definition_term": {},
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#2c393d",
    "margin": 2
  },
  "emph": {
    "color": "#6a7e87",
    "italic": true
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#00cfcf"
  },
  "h1": {
    "prefix": "# "
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "background_color": "#36bd36",
    "color": "#66aaaa",
    "prefix": "### "
  },
  "h4": {
    "background_color": "#36bd36",
    "color": "#66aaaa",
    "prefix": "#### "
  },
  "h5": {
    "background_color": "#36bd36",
    "color": "#66aaaa",
    "prefix": "##### "
  },
  "h6": {
    "background_color": "#36bd36",
    "bold": false,
    "color": "#66aaaa",
    "prefix": "###### "
  },
  "heading": {
    "background_color": "#0c0c0c",
    "block_suffix": "\n",
    "bold": true,
    "color": "#3dccd5"
  },
  "hr": {
    "color": "#659fa4",
    "format": "\n────────\n"
  },
  "html_block": {},
  "html_span": {},
  "image": {
    "color": "#6a7e87",
    "underline": true
  },
  "image_text": {
    "color": "#659fa4",
    "format": "image: {{.text}} →"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#00cfcf"
  },
  "link": {
    "color": "#6a7e87",
    "underline": true
  },
  "link_text": {
    "bold": true,
    "color": "#6a7e87"
  },
  "list": {
    "level_indent": 2
  },
  "paragraph": {},
  "strikethrough": {
    "crossed_out": true
  },
  "strong": {
    "bold": true,
    "color": "#6a7e87"
  },
  "table": {},
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "text": {}
